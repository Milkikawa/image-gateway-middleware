# ============================================================
# 上游 newapi 连接
# ============================================================

# newapi 在 Docker 网络中的地址。主机名必须是 newapi 容器在
# 共享网络中可解析的容器名或网络别名。
NEWAPI_BASE_URL=http://newapi:3000

# ============================================================
# 日志
# ============================================================

# 日志等级仅支持严格小写的 debug、info、warn、error；未设置时默认 info。
# 排障时可临时改为 debug，修改后需重启进程；Compose 部署需 recreate 容器。
# 日志只写入 stdout 并由 Docker 收集，不写入 /data。
LOG_LEVEL=info

# ============================================================
# 端口
# ============================================================

# 数据 API 端口（图片代理、生成接口、健康检查）。
# 同时用于程序监听和 Compose 发布，修改后须同步 PUBLIC_IMAGE_BASE_URL。
DATA_PORT=15880

# 管理页面端口（Web UI、登录、设置）。必须与 DATA_PORT 不同。
ADMIN_PORT=15881

# ============================================================
# 对外地址
# ============================================================

# 返回给 Koishi 的图片基础 URL。必须从 Koishi 所在网络可达，
# 端口部分须与 DATA_PORT 一致，路径以 /_gateway/images/ 结尾。
PUBLIC_IMAGE_BASE_URL=http://10.0.0.1:15880/_gateway/images/

# ============================================================
# 端口绑定与客户端白名单
# ============================================================

# 数据端口在宿主机上绑定的 IP。0.0.0.0 表示所有 IPv4 接口。
# 仅由 Compose ports 引用；Go 程序不读取此项。
EASYTIER_BIND_IP=0.0.0.0

# 管理端口在宿主机上绑定的 IP。同上。
LAN_BIND_IP=0.0.0.0

# 允许访问数据端口的客户端 IP/CIDR，逗号分隔。
# 支持单个地址（192.168.1.21）和网段（10.20.30.0/24）。
# 未设置时仅允许回环地址；无效项会导致服务拒绝启动。
# 回环地址 127.0.0.0/8 和 ::1 始终允许（保证容器健康检查）。
# 只检查直接 TCP 对端，不信任 X-Forwarded-For / X-Real-IP。
DATA_ALLOWED_CLIENTS=192.168.1.21,10.20.30.40

# 允许访问管理端口的客户端 IP/CIDR，规则同上。
# 建议比数据端口更严格，只放行管理设备。
ADMIN_ALLOWED_CLIENTS=192.168.1.21,10.20.30.40

# ============================================================
# Docker 网络（仅 compose.yaml 使用）
# ============================================================

# 默认 Compose 通过此变量查找宿主机上已存在的外部 Docker 网络，
# 让 image-gateway 与 newapi 容器在同一网络中通信。
# 使用 compose.1panel.yaml 时此项无效（网络固定为 1panel-network）。
NEWAPI_DOCKER_NETWORK=newapi

# ============================================================
# 数据存储
# ============================================================

# 容器内数据目录（数据库、图片、临时文件）。必须为绝对路径。
DATA_DIR=/data

# ============================================================
# 请求与下载限制
# ============================================================

# 接收的 JSON 请求体最大字节数（默认 4 MiB）。
MAX_JSON_BODY_BYTES=4194304

# newapi 返回的响应体最大字节数（默认 16 MiB）。
MAX_RESPONSE_BYTES=16777216

# 单张图片下载的最大字节数（默认 64 MiB）。
MAX_IMAGE_BYTES=67108864

# 转发请求到 newapi 的超时时间。
UPSTREAM_TIMEOUT=10m

# 下载单张图片的超时时间。
IMAGE_TIMEOUT=2m

# 并发图片下载工作线程数。
DOWNLOAD_WORKERS=4

# 调用 newapi 前要求的最小可用磁盘空间（默认 2 GiB）。
# 低于此值时网关返回 507，不再转发新请求。
MIN_FREE_BYTES=2147483648

# ============================================================
# 管理员账户
# ============================================================

# 首次启动时创建的管理员用户名。已有管理员时此项被忽略。
ADMIN_USERNAME=admin

# 首次启动时创建的管理员密码，至少 12 个字符。
# 已有管理员时修改此值不会自动重置密码。
ADMIN_PASSWORD=replace-with-at-least-12-characters

# ============================================================
# 安全
# ============================================================

# 管理页面 Cookie 是否仅通过 HTTPS 发送。
# HTTP 部署填 false，HTTPS 部署填 true。
COOKIE_SECURE=false
